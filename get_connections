#!/usr/bin/perl
use strict;
use warnings;
use Time::Piece;

my $PORT = "2346";

# Ensure the script is run with root privileges to read /proc/PID/fd/
if ($> != 0) {
    die "Error: This script must be run as root (sudo) to inspect process file descriptors.\n";
}

#print printf("%-21s %-21s %-8s %-15s %s\n", "Local Address", "Peer Address", "PID", "State", "Duration");
printf("%-21s %-21s %-8s %-15s %s\n", "Local Address", "Peer Address", "PID", "State", "Duration");
print "-" x 80 . "\n";

# Run 'ss' to get established TCP connections along with process details (-p)
open(my $fh, "-|", "ss -tneump 2>/dev/null") or die "Failed to execute ss: $!";

while (my $line = <$fh>)
{
	chomp($line);
	next if $. == 1; # Skip headers

	# Split columns based on whitespace
	my @cols = split(/\s+/, $line);
	next if @cols < 6;
	my $IsDesired = index($cols[6], "java");
	if ($IsDesired < 1)
	{
		next;
	}
print "cols = @cols\n";
	my $state = $cols[0];
	my $local = $cols[4];
	my $peer  = $cols[5];
print "peer = $peer\n";
	$IsDesired = index($local, "$PORT");	# ZZZ
	if ($IsDesired < 1)
	{
		next;
	}
    
	# Extract PID and FD from the users field, e.g., users:(("nginx",pid=1234,fd=5))
	if ($line =~ /pid=(\d+),fd=(\d+)/)
	{
		my $pid = $1;
		my $fd  = $2;
		print "pid = $pid\n";
        
		my $fd_path = "/proc/$pid/stat";
		if (-e $fd_path)
		{
			# Get the modification time (creation time of the socket FD link)
			my $mtime = (stat($fd_path))[9];
			print "mtime = $mtime\n";
 
			if ($mtime)
			{
				#print "Saw mtime\n";
				my $duration = calculate_duration($mtime);
print "duration = $duration\n";
				printf("%-21s %-21s %-8s %-15s %s\n", $local, $peer, $pid, $state, $duration);
			}
		}
	}
}
close($fh);

# Subroutine to calculate human-readable duration strings
sub calculate_duration
{
	my ($start_time) = @_;
	my $now = time();
	my $diff = $now - $start_time;

	if ($diff < 0) { $diff = 0; }

	my $days    = int($diff / 86400);
	my $hours   = int(($diff % 86400) / 3600);
	my $minutes = int(($diff % 3600) / 60);
	my $seconds = $diff % 60;

	my $duration_str = "";
	if ($days > 0)    { $duration_str .= "${days}d "; }
	if ($hours > 0)   { $duration_str .= "${hours}h "; }
	if ($minutes > 0) { $duration_str .= "${minutes}m "; }
	$duration_str .= "${seconds}s";

	return $duration_str;
}


# Subroutine to calculate human-readable duration strings
sub calculate_duration
{
	my ($start_time) = @_;
	my $now = time();
	my $diff = $now - $start_time;

	if ($diff < 0) { $diff = 0; }

	my $days	= int($diff / 86400);
	my $hours	= int(($diff % 86400) / 3600);
	my $minutes	= int(($diff % 3600) / 60);
	my $seconds	= $diff % 60;

	my $duration_str = "";
	if ($days > 0)		{ $duration_str .= "${days}d "; }
	if ($hours > 0)		{ $duration_str .= "${hours}h "; }
	if ($minutes > 0)	{ $duration_str .= "${minutes}m "; }
	$duration_str .= "${seconds}s";

	return $duration_str;
}


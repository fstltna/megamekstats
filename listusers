sub pretty_print_kb
{
	my $kb = shift;
	my @units = ('KB', 'MB', 'GB', 'TB', 'PB');
	my $unit_idx = 0;

	# Since input is in KB, scale up if >= 1024 KB
	#while ($kb >= 1024 && $unit_idx < $@units - 1)
	while ($kb >= 1024 && $unit_idx < @units - 1)
	{
		$kb /= 1024;
		$unit_idx++;
	}

	return sprintf("%.2f %s", $kb, $units[$unit_idx]);
}


#!/usr/bin/perl
use strict;
use warnings;

my $PORT = 2346;
my $ServerName ="";
my $NumUsers = 0;
my $RefreshRate = 65;
my $ProcessName = "java";
my $Version = "1.0.0";
my $PrefsFilename = "$ENV{HOME}/.listusersrc";
my $DEBUGMODE = "";
my $EDITOR = "/usr/bin/nano";
my $OutputFile = "";

print "listusers - Lists Users Logged Into MegaMek v$Version\n";
print "======================================================\n";

sub DebugPrint
{
        my $argument = shift;
        if ($DEBUGMODE ne "")
        {
                print $argument;
        }
}

my $defaultfile = <<'END_TEMPLATE';
# Put Server name here:
This is our Megamek server
# Put default port here
2346
# Refresh rate
65
# Process to check
java
# Editor to use
/usr/bin/nano
# Output file
/var/www/html/MM_Stats.html
# Get more apps like this at https://marisa-apps.retro-os.live
END_TEMPLATE

my $num_args = $#ARGV + 1;
if ($num_args != 0)
{
        if ($ARGV[0] eq "prefs")
        {
                system("$EDITOR $PrefsFilename");
                exit 0;
        }
        elsif ($ARGV[0] eq "debug")
        {
		$DEBUGMODE = "debug";
        }
	else
	{
		print "Invalid option - only options are \"prefs\" and \"debug\".\n";
	}
}
if (! -f $PrefsFilename)
{
	print "Settings file $PrefsFilename not found, creating it...\n";
	open(FILEOUT, '>', $PrefsFilename) or die $!;
	# print FILEOUT "$defaultfile\n";
	print FILEOUT "$defaultfile";
	close(FILEOUT);
	system("$EDITOR $PrefsFilename");
	print "Prefs modified - rerun this script\n";
	exit 0;
}

open(FILEIN, '<', $PrefsFilename) or die $!;
my $LastLine = 0;
while(<FILEIN>)
{
	# print $_;
	if ((substr($_, 0, 1) eq "#") || ($_ eq ""))
	{
		# skip over comments and blank lines
		next;
	}
	chop();
	if ($LastLine == 0)
	{
		$ServerName = $_;
		$LastLine++;
		DebugPrint("saw server name '$ServerName'\n");
	}
	elsif ($LastLine == 1)
	{
		$PORT = $_;
		DebugPrint("saw port '$PORT'\n");
		$LastLine++;
	}
	elsif ($LastLine == 2)
	{
		$RefreshRate = $_;
		$LastLine++;
		DebugPrint("saw refreshrate '$RefreshRate'\n");
	}
	elsif ($LastLine == 3)
	{
		$ProcessName = $_;
		$LastLine++;
		DebugPrint("saw processname '$ProcessName'\n");
	}
	elsif ($LastLine == 4)
	{
		$EDITOR = $_;
		$LastLine++;
		DebugPrint("saw editor '$EDITOR'\n");
	}
	elsif ($LastLine == 5)
	{
		$OutputFile = $_;
		$LastLine++;
		DebugPrint("saw outputfile '$OutputFile'\n");
	}
}
close(FILEIN);

open(FILEOUT, '>', $OutputFile) or die $!;
#print FILEOUT "$defaultfile";

my $IsRunning = `pgrep $ProcessName`;
if ($IsRunning eq "")
{
	print "Process $ProcessName is not running\n";
	exit 0;
}

my $PSCommand = "ps -p \$(pidof $ProcessName) -o etime=";
my $ProcTime = `$PSCommand`;
$ProcTime =~ s/^\s+//; # Removes leading whitespace
$ProcTime =~ s/\s+$//; # Removes trailing whitespace

my $OutputTop = <<"END_MESSAGE";
<html>
<head>
	<title>The $ServerName MegaMek server</title>
	<meta http-equiv="refresh" content="$RefreshRate">
</head>
<body>
	<h2 align=center>The $ServerName MegaMek server</h2>
	<p>MegaMek has been up for $ProcTime</p>
	<p>User Sessions:</p>
	<table border=2>
	<tr><th width=50%>User IP</th><th width=50%>Some Data</th></tr>
END_MESSAGE

print FILEOUT "$OutputTop\n";

my $cmd = "netstat -an | grep ESTABLISHED";
open(my $fh, "-|", $cmd) or die "Failed to run '$cmd': $!";

while (my $line = <$fh>)
{
	next if $line =~ /^\s*$/;

	# Match :2346 (IPv4/IPv6 variants) anywhere in the line,
	# including cases like ":::2346" or "[::]:2346"
	if ($line =~ /:\Q$PORT\E\b/)
	{
		$NumUsers++;
		#print $line;
		(my $foo1,my $foo2,my $foo3,my $foo4,my $UserIP,my $foo5) = split(' ',$line);
		print FILEOUT "<tr><td>$UserIP</td><td>Some Data</td></tr>\n";
	}
}

close($fh);

my $OutputBottom = <<"END_MESSAGE";
	</table>
	<p>Saw $NumUsers online player(s)</p>
</body>
</html>
END_MESSAGE

print FILEOUT "$OutputBottom\n";
print FILEOUT "<hr>\n";
my $current_time = localtime();
print FILEOUT "Last Updated at: $current_time\n";
close(FILEOUT);
exit 0;

